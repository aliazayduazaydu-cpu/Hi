local function GetInjectedTarget(): Instance
	local t = Targets[targetIdx]
	if t == "Character" then
		return LocalPlayer.Character or LocalPlayer
	elseif t == "ReplicatedStorage" then
		return ReplicatedStorage
	end
	return Workspace
end

local function BuildSandboxEnv()
	local targetObj = GetInjectedTarget()
	local env = {
		print = function(...)
			local parts = {}
			for i = 1, select("#", ...) do
				table.insert(parts, tostring(select(i, ...)))
			end
			AppendLog(table.concat(parts, "  "), THEME.TextPrimary)
		end,
		warn = function(...)
			local parts = {}
			for i = 1, select("#", ...) do
				table.insert(parts, tostring(select(i, ...)))
			end
			AppendLog("WARN: " .. table.concat(parts, "  "), THEME.Warn)
		end,
		error = function(msg)
			AppendLog("ERR: " .. tostring(msg), THEME.Error)
		end,
		Players = Players,
		Player = LocalPlayer,
		Workspace = Workspace,
		ReplicatedStorage = ReplicatedStorage,
		TweenService = TweenService,
		RunService = RunService,
		Target = targetObj,
		Track = function(inst: Instance)
			return GCManager:TrackInstance(inst)
		end,
		Connect = function(conn: RBXScriptConnection)
			return GCManager:TrackConnection(conn)
		end,
		task = task,
		Instance = Instance,
		Vector3 = Vector3,
		CFrame = CFrame,
		Color3 = Color3,
		UDim2 = UDim2,
		UDim = UDim,
		Enum = Enum,
		math = math,
		string = string,
		table = table,
		pcall = pcall,
		pairs = pairs,
		ipairs = ipairs,
		tostring = tostring,
		tonumber = tonumber,
		type = type,
		typeof = typeof,
	}
	setmetatable(env, { __index = _G })
	return env
end

local UndoStack: { string } = {}
local lastSnapshot = CodeBox.Text

local function ExecuteCurrentScript()
	local mode = Modes[modeIdx]
	local sourceCode = CodeBox.Text

	if sourceCode:gsub("%s+", "") == "" then
		AppendLog("Editor is empty.", THEME.Warn)
		return
	end

	if mode == "Preview" then
		local lines = select(2, sourceCode:gsub("\n", "")) + 1
		local kwHits = 0
		for _, kw in ipairs(KEYWORDS) do
			local _, c = sourceCode:gsub("%f[%w_]" .. kw .. "%f[^%w_]", "")
			kwHits += c
		end
		AppendLog(string.format("[PREVIEW] %d lines | %d chars | %d keywords | Target: %s", lines, #sourceCode, kwHits, Targets[targetIdx]), THEME.NeonCyan)
		return
	end

	if typeof(loadstring) ~= "function" then
		AppendLog("loadstring() is disabled in this game environment. Use Preview or enable LoadStringEnabled.", THEME.Warn)
		return
	end

	local fn, compileErr = loadstring(sourceCode)
	if not fn then
		AppendLog("Compile Error: " .. tostring(compileErr), THEME.Error)
		return
	end

	local env = BuildSandboxEnv()
	pcall(setfenv, fn, env)

	local co = task.spawn(function()
		local ok, runErr = pcall(fn)
		if not ok then
			if mode == "Debug" then
				AppendLog("DEBUG TRACEBACK: " .. tostring(runErr), THEME.Error)
			else
				AppendLog("Runtime Error: " .. tostring(runErr), THEME.Error)
			end
		elseif mode == "Debug" then
			AppendLog("[DEBUG] Execution completed with 0 errors.", THEME.Success)
		end
	end)

	GCManager:TrackThread(co)
end

