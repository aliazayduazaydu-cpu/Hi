local function FetchHubScripts(keyword: string, refreshRemote: boolean): { HubEntry }
	-- Simulated network latency + optional server-proxy hook
	task.wait(refreshRemote and 0.65 or 0.35)

	-- If you expose a RemoteFunction named "NexusHubFetch" in ReplicatedStorage,
	-- a server script can perform real HttpService:GetAsync() calls and return entries.
	local proxy = ReplicatedStorage:FindFirstChild("NexusHubFetch")
	if proxy and proxy:IsA("RemoteFunction") then
		local ok, remoteResults = pcall(function()
			return proxy:InvokeServer(keyword, refreshRemote)
		end)
		if ok and type(remoteResults) == "table" then
			return remoteResults
		end
	end

	local q = string.lower((keyword or ""):gsub("^%s+", ""):gsub("%s+$", ""))
	if q == "" then
		return HubCatalog
	end

	local matches = {}
	for _, item in ipairs(HubCatalog) do
		local hay = string.lower(item.Title .. " " .. item.Source .. " " .. table.concat(item.Tags, " "))
		if string.find(hay, q, 1, true) then
			table.insert(matches, item)
		end
	end
	return matches
end

