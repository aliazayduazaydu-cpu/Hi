local SavedScripts: { [string]: string } = {}

local function LoadSavedScripts()
	table.clear(SavedScripts)
	for name, code in pairs(DefaultScripts) do
		SavedScripts[name] = code
	end
	for _, attrObj in ipairs(StorageFolder:GetChildren()) do
		if attrObj:IsA("StringValue") then
			SavedScripts[attrObj.Name] = attrObj.Value
		end
	end
end

local function PersistScript(name: string, code: string)
	if name == "" then
		name = "Untitled.luau"
	end
	if not name:match("%.%w+$") then
		name ..= ".luau"
	end
	SavedScripts[name] = code

	local sv = StorageFolder:FindFirstChild(name) :: StringValue?
	if not sv then
		sv = Instance.new("StringValue")
		sv.Name = name
		sv.Parent = StorageFolder
	end
	sv.Value = code
	return name
end

LoadSavedScripts()

