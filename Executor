UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
        -- handled in combination below
    end

    local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)

    if ctrl and input.KeyCode == Enum.KeyCode.Return then
        executeCode()
    elseif ctrl and input.KeyCode == Enum.KeyCode.S then
        local active = getActiveScript()
        if active then
            active.code = CodeBox.Text
            saveScripts()
            logToConsole("Saved: " .. active.name, "success")
        end
    elseif ctrl and input.KeyCode == Enum.KeyCode.Z then
        -- simple undo: restore last saved code
        local active = getActiveScript()
        if active then
            CodeBox.Text = active.code
            updateHighlight()
            logToConsole("Undo: restored last saved code.", "system")
        end
    end
end)

