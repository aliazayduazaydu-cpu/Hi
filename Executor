local ConsoleFrame, ConsoleScroll, ConsoleLayout

local function logToConsole(message, level)
    level = level or "info"
    local color = T.TextPrimary
    if level == "error" then color = T.AccentRed
    elseif level == "warn" then color = T.AccentYellow
    elseif level == "success" then color = T.AccentGreen
    elseif level == "system" then color = T.AccentCyan
    end

    local prefix = "[" .. os.date("%H:%M:%S") .. "] "
    local entry = {
        text = prefix .. tostring(message),
        color = color,
        level = level,
    }
    table.insert(State.ConsoleLines, entry)
    if #State.ConsoleLines > CONFIG.MaxConsoleLines then
        table.remove(State.ConsoleLines, 1)
    end

    if ConsoleLayout then
        -- Rebuild console display (simple and reliable)
        for _, child in ipairs(ConsoleLayout:GetChildren()) do
            if child:IsA("TextLabel") then
                child:Destroy()
            end
        end
        for _, line in ipairs(State.ConsoleLines) do
            local lbl = create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 18),
                BackgroundTransparency = 1,
                Font = F.Code,
                TextSize = 13,
                TextColor3 = line.color,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = line.text,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = ConsoleLayout,
            })
            lbl.RichText = false
        end
        task.defer(function()
            if ConsoleScroll then
                ConsoleScroll.CanvasPosition = Vector2.new(0, math.max(0, ConsoleLayout.AbsoluteSize.Y - ConsoleScroll.AbsoluteSize.Y))
            end
        end)
    end
end

-- ============================================================
-- SYNTAX HIGHLIGHTING (RichText overlay simulation)
-- ============================================================
local KEYWORDS = {
    ["local"] = true, ["function"] = true, ["if"] = true, ["then"] = true,
    ["else"] = true, ["elseif"] = true, ["end"] = true, ["return"] = true,
    ["for"] = true, ["while"] = true, ["do"] = true, ["repeat"] = true,
    ["until"] = true, ["break"] = true, ["and"] = true, ["or"] = true,
    ["not"] = true, ["in"] = true, ["nil"] = true, ["true"] = true,
    ["false"] = true, ["game"] = true, ["workspace"] = true,
    ["script"] = true, ["Instance"] = true, ["Vector3"] = true,
    ["CFrame"] = true, ["Enum"] = true, ["wait"] = true, ["task"] = true,
    ["print"] = true, ["warn"] = true, ["error"] = true, ["pcall"] = true,
}

local function escapeRichText(s)
    s = s:gsub("&", "&amp;")
    s = s:gsub("<", "&lt;")
    s = s:gsub(">", "&gt;")
    return s
end

local function highlightCode(code)
    -- Token-based simulation: comments, strings, keywords, numbers
    local result = {}
    local i = 1
    local n = #code
    while i <= n do
        local c = code:sub(i, i)
        -- Comments
        if c == "-" and code:sub(i + 1, i + 1) == "-" then
            local j = code:find("\n", i + 2) or n + 1
            local comment = code:sub(i, j - 1)
            table.insert(result, '<font color="#6B7280">' .. escapeRichText(comment) .. '</font>')
            i = j
        -- Strings
        elseif c == '"' or c == "'" then
            local quote = c
            local j = i + 1
            while j <= n do
                local cj = code:sub(j, j)
                if cj == "\\" then
                    j = j + 2
                elseif cj == quote then
                    break
                else
                    j = j + 1
                end
            end
            local str = code:sub(i, math.min(j, n))
            table.insert(result, '<font color="#38F157">' .. escapeRichText(str) .. '</font>')
            i = j + 1
        -- Numbers
        elseif c:match("%d") then
            local j = i
            while j <= n and code:sub(j, j):match("[%d%.]") do
                j = j + 1
            end
            local num = code:sub(i, j - 1)
            table.insert(result, '<font color="#FFC600">' .. num .. '</font>')
            i = j
        -- Identifiers / keywords
        elseif c:match("[%a_]") then
            local j = i
            while j <= n and code:sub(j, j):match("[%w_]") do
                j = j + 1
            end
            local word = code:sub(i, j - 1)
            if KEYWORDS[word] then
                table.insert(result, '<font color="#A057F8">' .. word .. '</font>')
            elseif word == "true" or word == "false" then
                table.insert(result, '<font color="#D68017">' .. word .. '</font>')
            else
                table.insert(result, escapeRichText(word))
            end
            i = j
        else
            table.insert(result, escapeRichText(c))
            i = i + 1
        end
    end
    return table.concat(result)
end

