local isFetching = false
local function RefreshExplorer(keyword: string, forceRemote: boolean)
	if isFetching then
		return
	end
	isFetching = true
	LoadingSpinner.Visible = true
	ExplorerScroll.Position = UDim2.fromOffset(6, 86)
	ExplorerScroll.Size = UDim2.new(1, -12, 1, -92)

	local spinnerCo = task.spawn(function()
		local frames = { "⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏" }
		local idx = 1
		while isFetching do
			LoadingSpinner.Text = frames[idx] .. " Fetching hub scripts..."
			idx = (idx % #frames) + 1
			task.wait(0.08)
		end
	end)

	local hubResults = FetchHubScripts(keyword, forceRemote)
	isFetching = false
	pcall(task.cancel, spinnerCo)
	LoadingSpinner.Visible = false
	ExplorerScroll.Position = UDim2.fromOffset(6, 66)
	ExplorerScroll.Size = UDim2.new(1, -12, 1, -72)

	ClearExplorerList()
	AddSectionHeader("SAVED SCRIPTS", THEME.NeonCyan)

	local q = string.lower(keyword or "")
	for name, code in pairs(SavedScripts) do
		if q == "" or string.find(string.lower(name), q, 1, true) then
			AddScriptRow(name, "LOCAL SAVED", THEME.NeonCyan, code)
		end
	end

	AddSectionHeader("WEB SCRIPT HUB", THEME.NeonPurple)
	for _, entry in ipairs(hubResults) do
		AddScriptRow(entry.Title, entry.Source, THEME.NeonPurple, entry.Code)
	end
end

