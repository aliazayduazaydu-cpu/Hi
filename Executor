-- Keyboard Shortcuts: Ctrl+Enter (Execute), Ctrl+S (Save), Ctrl+Z (Undo)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
		return
	end
	local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
	if not ctrl then
		return
	end

	if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
		ExecuteCurrentScript()
	elseif input.KeyCode == Enum.KeyCode.S then
		local savedName = PersistScript(ScriptNameInput.Text, CodeBox.Text)
		ScriptNameInput.Text = savedName
		AppendLog("Saved '" .. savedName .. "' (Ctrl+S).", THEME.Success)
	elseif input.KeyCode == Enum.KeyCode.Z then
		local prev = table.remove(UndoStack)
		if prev then
			CodeBox.Text = prev
			lastSnapshot = prev
			UpdateSyntaxHighlight()
			AppendLog("Undo applied (Ctrl+Z).", THEME.NeonCyan)
		end
	end
end)

