-- Helper function to create script items
local function createScriptItem(name, code, parent)
    local item = Instance.new("TextButton")
    item.Name = name:gsub("%s", "")
    item.Size = UDim2.new(0.9, -20, 0, 40)
    item.Position = UDim2.new(0, 0, 0, 0)
    item.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    item.BorderSizePixel = 0
    item.Text = name
    item.TextColor3 = Color3.fromRGB(255, 255, 255)
    item.Font = Enum.Font.Gotham
    item.TextSize = 14
    item.TextXAlignment = Enum.TextXAlignment.Left
    item.Parent = parent
    
    local itemCorner = Instance.new("UICorner")
    itemCorner.CornerRadius = UDim.new(0, 6)
    itemCorner.Parent = item
    
    -- Hover effect
    item.MouseEnter:Connect(function()
        item.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    end)
    
    item.MouseLeave:Connect(function()
        item.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    end)
    
    -- Click to execute
    item.MouseButton1Click:Connect(function()
        pcall(function()
            loadstring(code)()
        end)
        
        -- Visual feedback
        item.BackgroundColor3 = Color3.fromRGB(0, 122, 255)
        wait(0.2)
        item.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    end)
    
    return item
end

