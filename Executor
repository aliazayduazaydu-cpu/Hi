-- ============================================================================
-- ENVIRONMENT & GARBAGE COLLECTION MANAGER
-- ============================================================================
local GCManager = {
	Connections = {} :: { RBXScriptConnection },
	Threads = {} :: { thread },
	Instances = {} :: { Instance },
}

function GCManager:TrackConnection(conn: RBXScriptConnection)
	table.insert(self.Connections, conn)
	return conn
end

function GCManager:TrackThread(co: thread)
	CollectionService:AddTag(LocalPlayer, TAG_ACTIVE_THREAD)
	table.insert(self.Threads, co)
	return co
end

function GCManager:TrackInstance(inst: Instance)
	CollectionService:AddTag(inst, TAG_MANAGED_INSTANCE)
	table.insert(self.Instances, inst)
	return inst
end

function GCManager:Cleanup(logFn: ((string, Color3?) -> ())?)
	local cleaned = 0

	for _, conn in ipairs(self.Connections) do
		if conn.Connected then
			conn:Disconnect()
			cleaned += 1
		end
	end
	table.clear(self.Connections)

	for _, co in ipairs(self.Threads) do
		if coroutine.status(co) ~= "dead" then
			pcall(task.cancel, co)
			cleaned += 1
		end
	end
	table.clear(self.Threads)

	for _, inst in ipairs(self.Instances) do
		if inst and inst.Parent then
			pcall(inst.Destroy, inst)
			cleaned += 1
		end
	end
	table.clear(self.Instances)

	for _, tagged in ipairs(CollectionService:GetTagged(TAG_MANAGED_INSTANCE)) do
		if tagged and tagged.Parent then
			pcall(tagged.Destroy, tagged)
			cleaned += 1
		end
	end

	CollectionService:RemoveTag(LocalPlayer, TAG_ACTIVE_THREAD)

	if logFn then
		logFn(string.format("[GC] Swept %d active handles/instances.", cleaned), THEME.Success)
	end
end

