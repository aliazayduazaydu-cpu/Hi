local function simulateWebSearch(query)
    query = query:lower():gsub("^%s+", ""):gsub("%s+$", "")
    if query == "" then
        return SCRIPT_HUB_SOURCES
    end
    local results = {}
    for _, src in ipairs(SCRIPT_HUB_SOURCES) do
        local match = src.name:lower():find(query, 1, true)
        if not match then
            for _, tag in ipairs(src.tags) do
                if tag:find(query, 1, true) then
                    match = true
                    break
                end
            end
        end
        if match then
            table.insert(results, src)
        end
    end
    return results
end

local function fetchWebScript(source, callback)
    -- In a standard LocalScript, HttpService is server-only.
    -- We simulate the fetch with a loading delay.
    if State.LoadingWeb then
        logToConsole("A web request is already in progress.", "warn")
        return
    end
    State.LoadingWeb = true
    logToConsole("Fetching: " .. source.name .. " ...", "system")

    task.spawn(function()
        task.wait(0.8) -- simulated network latency

        local success, realCode = false, nil
        -- Attempt real HttpService if available (custom executor environments)
        local httpOk, httpService = pcall(function()
            return game:GetService("HttpService")
        end)
        if httpOk and httpService and httpService.HttpEnabled then
            local reqOk, res = pcall(function()
                return httpService:GetAsync(source.url)
            end)
            if reqOk and res then
                success = true
                realCode = res
            end
        end

        State.LoadingWeb = false

        if success and realCode then
            callback(true, realCode)
            logToConsole("Fetched live script from web.", "success")
        else
            callback(false, source.simulatedCode)
            logToConsole("Web APIs unavailable on client. Loaded simulated script.", "warn")
        end
    end)
end

-- ============================================================
-- SCRIPT STORAGE (Auto-save to PlayerGui)
-- ============================================================
local function saveScripts()
    local folder = PlayerGui:FindFirstChild("CyberExecutor_Data")
    if not folder then
        folder = create("Folder", {
            Name = "CyberExecutor_Data",
            Parent = PlayerGui,
        })
    end

    local data = {}
    for _, script in ipairs(State.Scripts) do
        table.insert(data, {
            id = script.id,
            name = script.name,
            code = script.code,
        })
    end

    local json = HttpService:JSONEncode(data)
    local existing = folder:FindFirstChild("SavedScripts")
    if existing then existing:Destroy() end
    create("StringValue", {
        Name = "SavedScripts",
        Value = json,
        Parent = folder,
    })
end

local function loadScripts()
    local folder = PlayerGui:FindFirstChild("CyberExecutor_Data")
    if not folder then return end
    local sv = folder:FindFirstChild("SavedScripts")
    if not sv then return end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(sv.Value)
    end)
    if ok and type(data) == "table" then
        State.Scripts = data
        if #State.Scripts > 0 then
            State.ActiveScriptId = State.Scripts[1].id
        end
    end
end

local function addScript(name, code)
    local id = tostring(os.time()) .. "_" .. tostring(math.random(1000, 9999))
    local script = {
        id = id,
        name = name or "Untitled Script",
        code = code or "-- New script\nprint(\"Hello, world!\")\n",
    }
    table.insert(State.Scripts, script)
    State.ActiveScriptId = id
    saveScripts()
    return script
end

local function getActiveScript()
    for _, s in ipairs(State.Scripts) do
        if s.id == State.ActiveScriptId then
            return s
        end
    end
    return nil
end

