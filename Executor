-- ============================================================
-- UTILITY HELPERS
-- ============================================================
local function create(className, props, children)
    local inst = Instance.new(className)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then
            inst[k] = v
        end
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    if props and props.Parent then
        inst.Parent = props.Parent
    end
    return inst
end

local function tween(inst, props, duration, style, direction)
    local info = TweenInfo.new(
        duration or 0.25,
        style or Enum.EasingStyle.Quart,
        direction or Enum.EasingDirection.Out
    )
    local tw = TweenService:Create(inst, info, props)
    tw:Play()
    return tw
end

local function addCorner(inst, radius)
    return create("UICorner", {
        CornerRadius = UDim.new(0, radius or U.CornerRadius),
        Parent = inst,
    })
end

local function addStroke(inst, color, thickness)
    return create("UIStroke", {
        Color = color or T.Border,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = inst,
    })
end

local function addPadding(inst, pad)
    return create("UIPadding", {
        PaddingTop = UDim.new(0, pad),
        PaddingBottom = UDim.new(0, pad),
        PaddingLeft = UDim.new(0, pad),
        PaddingRight = UDim.new(0, pad),
        Parent = inst,
    })
end

local function gradient(inst, c1, c2, rotation)
    return create("UIGradient", {
        Color = ColorSequence.new(c1 or T.AccentCyan, c2 or T.AccentPurple),
        Rotation = rotation or 90,
        Parent = inst,
    })
end

local function safeCallback(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[CyberExecutor] Callback error: " .. tostring(err))
    end
    return ok, err
end

