local function AddNeonGradient(parent: GuiObject, c1: Color3, c2: Color3, rotation: number?)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, c1),
		ColorSequenceKeypoint.new(1, c2),
	})
	g.Rotation = rotation or 35
	g.Parent = parent
	return g
end

local function BindHoverScale(btn: GuiButton, hoverScale: number?)
	local scale = Instance.new("UIScale")
	scale.Scale = 1
	scale.Parent = btn

	local target = hoverScale or 1.05
	btn.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = target,
		}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = 1,
		}):Play()
	end)
end

