-- ============================================================
-- EXECUTION ENGINE (Simulated / Real if available)
-- ============================================================
local function getExecutionMode()
    return State.ExecutionMode
end

local function setStatus(text, color)
    StatusLabel.Text = text
    StatusLabel.TextColor3 = color or T.TextSecondary
end

function executeCode()
    local code = CodeBox.Text
    if code:gsub("%s", "") == "" then
        logToConsole("Nothing to execute.", "warn")
        return
    end

    local mode = getExecutionMode()
    logToConsole("─── EXECUTE [" .. mode .. "] ───", "system")
    setStatus("● RUNNING", T.AccentYellow)

    -- Check for real loadstring (custom executor environments)
    local hasLoadstring = (type(loadstring) == "function")
    if hasLoadstring and mode ~= "Preview" then
        local func, compileErr = loadstring(code)
        if not func then
            logToConsole("Compile error: " .. tostring(compileErr), "error")
            setStatus("● ERROR", T.AccentRed)
            return
        end
        local ok, runtimeErr = pcall(func)
        if ok then
            logToConsole("Execution completed.", "success")
            setStatus("● READY", T.AccentGreen)
        else
            logToConsole("Runtime error: " .. tostring(runtimeErr), "error")
            setStatus("● ERROR", T.AccentRed)
        end
    else
        -- Simulated execution
        logToConsole("Mode: " .. mode, "system")
        if mode == "Preview" then
            logToConsole("Preview: code compiled (not executed).", "system")
            logToConsole("Lines: " .. tostring(select(2, code:gsub("\n", "")) + 1), "system")
            logToConsole("Characters: " .. tostring(#code), "system")
        else
            -- Extract print statements for simulation
            local printed = 0
            for line in code:gmatch("[^\n]+") do
                local msg = line:match('print%s*%(%s*"(.-)"%s*%)')
                if msg then
                    logToConsole("[OUTPUT] " .. msg, "success")
                    printed = printed + 1
                end
            end
            if printed == 0 then
                logToConsole("Simulated execution complete (no print statements detected).", "success")
            end
            if mode == "Debug" then
                logToConsole("Debug: execution trace complete. No runtime errors.", "system")
            end
        end
        setStatus("● READY", T.AccentGreen)
    end
    logToConsole("─────────────────────────────", "system")
end

