local function refreshScriptList(filterText)
    for _, child in ipairs(ScriptListLayout:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local query = (filterText or ""):lower()
    local shown = 0
    for _, s in ipairs(State.Scripts) do
        if query == "" or s.name:lower():find(query, 1, true) then
            local isActive = (s.id == State.ActiveScriptId)
            local btn = create("TextButton", {
                Size = UDim2.new(1, -8, 0, 32),
                BackgroundColor3 = isActive and T.SurfaceLight or T.EditorBg,
                BorderSizePixel = 0,
                Font = F.UIMedium,
                TextSize = 12,
                TextColor3 = isActive and T.AccentCyan or T.TextPrimary,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = "  📄  " .. s.name,
                AutoButtonColor = false,
                LayoutOrder = shown,
                Parent = ScriptListLayout,
            })
            addCorner(btn, 5)
            btn.MouseButton1Click:Connect(function()
                State.ActiveScriptId = s.id
                CodeBox.Text = s.code
                updateHighlight()
                refreshScriptList(SearchBox.Text)
                logToConsole("Opened: " .. s.name, "system")
            end)
            shown = shown + 1
        end
    end
    ScriptListScroll.CanvasSize = UDim2.new(0, 0, 0, shown * 36)
end

local function refreshWebResults(query)
    for _, child in ipairs(ScriptListLayout:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local results = simulateWebSearch(query)
    local shown = 0
    for _, src in ipairs(results) do
        local btn = create("TextButton", {
            Size = UDim2.new(1, -8, 0, 42),
            BackgroundColor3 = T.EditorBg,
            BorderSizePixel = 0,
            Font = F.UIMedium,
            TextSize = 11,
            TextColor3 = T.TextPrimary,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = "  🌐  " .. src.name .. "\n     " .. src.url:sub(1, 40) .. "...",
            AutoButtonColor = false,
            LayoutOrder = shown,
            Parent = ScriptListLayout,
        })
        addCorner(btn, 5)
        btn.MouseButton1Click:Connect(function()
            fetchWebScript(src, function(success, code)
                local existing = nil
                for _, s in ipairs(State.Scripts) do
                    if s.name == src.name then existing = s; break end
                end
                if existing then
                    existing.code = code
                    State.ActiveScriptId = existing.id
                else
                    local newScript = addScript(src.name, code)
                    State.ActiveScriptId = newScript.id
                end
                CodeBox.Text = code
                updateHighlight()
                refreshScriptList()
                logToConsole("Loaded: " .. src.name, success and "success" or "warn")
            end)
        end)
        shown = shown + 1
    end
    ScriptListScroll.CanvasSize = UDim2.new(0, 0, 0, shown * 48)
end

