local function makeWindowButton(text, color, onClick, xOffset)
    local btn = create("TextButton", {
        Size = UDim2.new(0, 28, 0, 28),
        Position = UDim2.new(1, -xOffset, 0.5, -14),
        BackgroundColor3 = T.SurfaceLight,
        BorderSizePixel = 0,
        Font = F.UIBold,
        TextSize = 16,
        TextColor3 = T.TextSecondary,
        Text = text,
        AutoButtonColor = false,
        Parent = TitleBar,
    })
    addCorner(btn, 6)
    local hover = false
    btn.MouseEnter:Connect(function()
        if not hover then
            hover = true
            tween(btn, { BackgroundColor3 = color }, 0.15)
        end
    end)
    btn.MouseLeave:Connect(function()
        hover = false
        tween(btn, { BackgroundColor3 = T.SurfaceLight }, 0.15)
    end)
    btn.MouseButton1Click:Connect(onClick)
    return btn
end

